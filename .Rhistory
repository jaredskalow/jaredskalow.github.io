index = c("unit_id", "year"),
xlab = "Year", ylab = "Precinct",
main="",
# legend.pos="right",
background="transparent",
display.all = TRUE, gridOff = TRUE, by.timing = TRUE) +
ggplot2::theme(legend.position = "right")
# Static TWFE
twfe_static <- feols(support ~ within_halfmi | unit_id + year,
data = df, cluster = "unit_id")
library(tidyverse)
library(fixest)
