library(curl)
library(jsonlite)
library(dplyr)
if (!requireNamespace("stringdist", quietly = TRUE))
install.packages("stringdist", repos = "https://cloud.r-project.org")
library(stringdist)
setwd("/Users/jaredkalow/Library/Mobile Documents/com~apple~CloudDocs/Documents/Projects/US Transit/LA County")
BASE_URL <- "https://portal.assessor.lacounty.gov/api"
# ── helpers ──────────────────────────────────────────────────────────────────
api_get <- function(url) {
h <- new_handle()
handle_setopt(h, ssl_verifypeer = 0L, ssl_verifyhost = 0L)
handle_setheaders(h, "Accept" = "application/json")
resp <- curl_fetch_memory(url, handle = h)
if (resp$status_code != 200) return(NULL)
fromJSON(rawToChar(resp$content))
}
best_match <- function(parcels, address, city) {
# Pick the parcel whose SitusStreet + SitusCity is closest to the query
target <- toupper(paste(address, city))
candidates <- toupper(paste(parcels$SitusStreet, parcels$SitusCity))
idx <- which.min(stringdist(target, candidates, method = "jw"))
parcels[idx, ]
}
flatten_list <- function(x, prefix = "") {
# Recursively flatten a nested list to a named vector
result <- list()
for (nm in names(x)) {
val <- x[[nm]]
key <- if (nchar(prefix) > 0) paste0(prefix, "_", nm) else nm
if (is.list(val) && !is.data.frame(val)) {
result <- c(result, flatten_list(val, key))
} else if (is.data.frame(val) || length(val) > 1) {
# Skip nested tables (assessment history, ownership history lists)
next
} else {
result[[key]] <- if (is.null(val) || length(val) == 0) NA else as.character(val)
}
}
result
}
# ── main scrape function ──────────────────────────────────────────────────────
scrape_parcel <- function(address, city) {
query    <- utils::URLencode(paste(address, city), reserved = FALSE)
search   <- api_get(paste0(BASE_URL, "/search?search=", query))
if (is.null(search) || length(search$Parcels) == 0) {
message("No results for: ", address, ", ", city)
return(NULL)
}
match    <- best_match(search$Parcels, address, city)
ain      <- match$AIN
detail   <- api_get(paste0(BASE_URL, "/parceldetail?ain=", ain))
assess   <- api_get(paste0(BASE_URL, "/parcel_assessmenthistory?ain=", ain))
ownership <- api_get(paste0(BASE_URL, "/parcel_ownershiphistory?ain=", ain))
# Flatten parcel detail (land + building info)
parcel_flat <- as.data.frame(flatten_list(detail$Parcel), stringsAsFactors = FALSE)
# Most recent assessment record
assess_flat <- if (!is.null(assess$Parcel_AssessmentHistory) &&
nrow(assess$Parcel_AssessmentHistory) > 0) {
assess$Parcel_AssessmentHistory[1, ] |>
rename_with(~ paste0("assess_", .))
} else {
data.frame()
}
# Most recent ownership record
own_flat <- if (!is.null(ownership$Parcel_OwnershipHistory) &&
nrow(ownership$Parcel_OwnershipHistory) > 0) {
ownership$Parcel_OwnershipHistory[1, ] |>
rename_with(~ paste0("own_", .))
} else {
data.frame()
}
# Add query inputs and matched parcel info
meta <- data.frame(
query_address  = address,
query_city     = city,
matched_street = match$SitusStreet,
matched_city   = match$SitusCity,
matched_zip    = match$SitusZipCode,
AIN            = ain,
stringsAsFactors = FALSE
)
bind_cols(meta, parcel_flat, assess_flat, own_flat)
}
# ── run in parallel ───────────────────────────────────────────────────────────
library(parallel)
N_WORKERS    <- detectCores() - 1  # leave one core free
TRANCHE_SIZE <- 100000             # rows per tranche
PROGRESS_INT <- 5000               # log progress every N rows within a tranche
RUN_TRANCHE  <- 6                  # set to NULL to run all tranches
addrs_raw  <- readRDS("output/voter_addresses.rds")
addrs      <- addrs_raw |>
mutate(address = trimws(toupper(address)),
city    = trimws(toupper(city))) |>
distinct(address, city)
n_total    <- nrow(addrs)
cat(sprintf("Raw rows        : %d\n", nrow(addrs_raw)))
cat(sprintf("After dedup     : %d (%.1f%% unique)\n\n",
n_total, 100 * n_total / nrow(addrs_raw)))
n_tranches <- ceiling(n_total / TRANCHE_SIZE)
cat(sprintf("Total addresses : %d\n", n_total))
cat(sprintf("Tranche size    : %d\n", TRANCHE_SIZE))
cat(sprintf("Total tranches  : %d\n", n_tranches))
cat(sprintf("Workers         : %d\n", N_WORKERS))
cat(sprintf("Est. per tranche: ~%.1f hours\n\n", TRANCHE_SIZE / N_WORKERS / 3600))
# PSOCK cluster works on macOS (fork-based mclapply crashes with curl)
cl <- makeCluster(N_WORKERS)
clusterExport(cl, c("api_get", "best_match", "flatten_list", "scrape_parcel", "BASE_URL", "addrs"))
invisible(clusterEvalQ(cl, {
library(curl)
library(jsonlite)
library(dplyr)
library(stringdist)
}))
tranche_seq <- if (!is.null(RUN_TRANCHE)) RUN_TRANCHE else seq_len(n_tranches)
for (tranche in tranche_seq) {
out_file <- sprintf("output/assessor_tranche_%02d.rds", tranche)
if (file.exists(out_file)) {
cat(sprintf("[Tranche %d/%d] Already done, skipping.\n", tranche, n_tranches))
next
}
idx_start <- (tranche - 1) * TRANCHE_SIZE + 1
idx_end   <- min(tranche * TRANCHE_SIZE, n_total)
batch     <- idx_start:idx_end
cat(sprintf("[Tranche %d/%d] Rows %d-%d...\n", tranche, n_tranches, idx_start, idx_end))
t_start   <- proc.time()["elapsed"]
sub_seqs  <- split(batch, ceiling(seq_along(batch) / PROGRESS_INT))
results   <- list()
for (s in seq_along(sub_seqs)) {
sub_batch <- sub_seqs[[s]]
sub_res   <- parLapply(
cl,
sub_batch,
function(i) {
tryCatch(
scrape_parcel(addrs$address[i], addrs$city[i]),
error = function(e) {
message(sprintf("Row %d error: %s", i, e$message))
NULL
}
)
}
)
results   <- c(results, sub_res)
elapsed_s <- proc.time()["elapsed"] - t_start
pct       <- 100 * length(results) / length(batch)
eta_hrs   <- (elapsed_s / length(results)) * (length(batch) - length(results)) / 3600
cat(sprintf("  %d/%d (%.0f%%) | elapsed: %.1f min | ETA: %.1f hrs\n",
length(results), length(batch), pct, elapsed_s / 60, eta_hrs))
}
elapsed  <- proc.time()["elapsed"] - t_start
combined <- bind_rows(results)
saveRDS(combined, out_file)
cat(sprintf("  Done in %.1f hrs | %d results saved to %s\n",
elapsed / 3600, nrow(combined), out_file))
}
stopCluster(cl)
