cl <- makeCluster(N_WORKERS)
clusterExport(cl, c("api_get", "best_match", "flatten_list", "scrape_parcel", "BASE_URL", "addrs"))
invisible(clusterEvalQ(cl, {
library(curl)
library(jsonlite)
library(dplyr)
library(stringdist)
}))
tranche_seq <- if (!is.null(RUN_TRANCHE)) RUN_TRANCHE else seq_len(n_tranches)
for (tranche in tranche_seq) {
out_file <- sprintf("output/assessor_tranche_%02d.rds", tranche)
if (file.exists(out_file)) {
cat(sprintf("[Tranche %d/%d] Already done, skipping.\n", tranche, n_tranches))
next
}
idx_start <- (tranche - 1) * TRANCHE_SIZE + 1
idx_end   <- min(tranche * TRANCHE_SIZE, n_total)
batch     <- idx_start:idx_end
cat(sprintf("[Tranche %d/%d] Rows %d-%d...\n", tranche, n_tranches, idx_start, idx_end))
t_start   <- proc.time()["elapsed"]
sub_seqs  <- split(batch, ceiling(seq_along(batch) / PROGRESS_INT))
results   <- list()
for (s in seq_along(sub_seqs)) {
sub_batch <- sub_seqs[[s]]
sub_res   <- parLapply(
cl,
sub_batch,
function(i) {
tryCatch(
scrape_parcel(addrs$address[i], addrs$city[i]),
error = function(e) {
message(sprintf("Row %d error: %s", i, e$message))
NULL
}
)
}
)
results   <- c(results, sub_res)
elapsed_s <- proc.time()["elapsed"] - t_start
pct       <- 100 * length(results) / length(batch)
eta_hrs   <- (elapsed_s / length(results)) * (length(batch) - length(results)) / 3600
cat(sprintf("  %d/%d (%.0f%%) | elapsed: %.1f min | ETA: %.1f hrs\n",
length(results), length(batch), pct, elapsed_s / 60, eta_hrs))
}
elapsed  <- proc.time()["elapsed"] - t_start
combined <- bind_rows(results)
saveRDS(combined, out_file)
cat(sprintf("  Done in %.1f hrs | %d results saved to %s\n",
elapsed / 3600, nrow(combined), out_file))
}
stopCluster(cl)
cat("\nAll tranches complete.\n")
