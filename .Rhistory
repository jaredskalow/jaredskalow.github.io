out_dir <- "data_modified"
fig_dir <- "output/figures"
panel_long <- readRDS(file.path(out_dir, "panel_long.rds"))
# Create full dataset with all 5 years (2004-2020)
acs_demo_cols <- names(panel_long) |> str_subset("^(pct_|median_)")
df_all <- panel_long |>
select(SRPREC, year, support, turnout, dem_share, pres_dem,
within_halfmi, within_1mi, dist_miles,
exposure_years,
TOTREG, TOTVOTE,
any_of(acs_demo_cols))
# Create integer unit ID (required by some packages)
df_all <- df_all |>
mutate(unit_id = as.integer(factor(SRPREC)))
# Analysis dataset for ballot measure support (drops 2004 and 2020 — no ballot measure)
df <- df_all |>
filter(!is.na(support))
# Determine first treatment period for each precinct (staggered adoption)
# Treatment = within half mile of a transit station
df <- df |>
group_by(SRPREC) |>
arrange(year) |>
mutate(
first_treat = {
treated_years <- year[within_halfmi == 1]
if (length(treated_years) == 0) NA_integer_
else min(treated_years)
}
) |>
ungroup()
# Time relative to first treatment
df <- df |>
mutate(
time_to_treat = ifelse(is.na(first_treat), NA_integer_,
year - first_treat)
)
# Create a binary "ever treated" indicator
df <- df |>
mutate(treat = as.integer(!is.na(first_treat)))
cat(sprintf("  Analysis sample: %d obs, %d precincts, %d years\n",
nrow(df), n_distinct(df$SRPREC), n_distinct(df$year)))
# Treatment adoption structure
cat("\n  Treatment adoption (within_halfmi = 0.5 mile):\n")
adopt <- df |>
distinct(SRPREC, first_treat) |>
count(first_treat)
print(adopt)
# ==========================================================================
# 2. panelView: Visualize treatment patterns
# ==========================================================================
cat("\n=== panelView: Treatment visualization ===\n")
pv_data <- df |> select(unit_id, year, support, within_halfmi)
pv <- panelview(support ~ within_halfmi, data = as.data.frame(pv_data),
index = c("unit_id", "year"),
xlab = "Year", ylab = "Precinct",
main="",
# legend.pos="right",
background="transparent",
display.all = TRUE, gridOff = TRUE, by.timing = TRUE) +
ggplot2::theme(legend.position = "right")
library(PanelMatch)
