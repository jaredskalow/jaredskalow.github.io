panel_long  <- readRDS("data_modified/panel_long.rds")
new_res     <- readRDS("data_modified/pv_new_residents_precinct.rds")
did_results <- readRDS("data_modified/did_results.rds")
cat(sprintf("  Panel: %d precinct-year rows\n", nrow(panel_long)))
cat(sprintf("  New residents: %d precincts\n",  nrow(new_res)))
cat(sprintf("  DiD estimates: %d methods\n",    nrow(did_results)))
# ==========================================================================
# 2. Compute α and compositional effects per year
# ==========================================================================
cat("\nComputing alpha (new residents / votes cast) per year...\n")
year_stats <- map_dfr(BALLOT_YEARS, function(yr) {
va_col  <- paste0("est_va_adults_", yr)
reg_col <- paste0("TOTREG_", yr)   # in new_res (for reference)
# Panel data for this year (ballot measure years only)
pl_yr <- panel_long |>
filter(year == yr, !is.na(support), !is.na(within_halfmi)) |>
select(SRPREC, year, support, within_halfmi, TOTVOTE)
# Join new-resident estimates (precincts with no new construction get 0)
pl_yr <- pl_yr |>
left_join(
new_res |> select(SRPREC, est_va = all_of(va_col)),
by = "SRPREC"
) |>
mutate(
est_va = replace_na(est_va, 0),
# α: new VA adults as share of votes cast (cap at 1)
alpha  = pmin(est_va / TOTVOTE, 1),
alpha  = ifelse(is.nan(alpha) | is.infinite(alpha) | TOTVOTE == 0,
NA_real_, alpha)
)
treated  <- pl_yr |> filter(within_halfmi == 1, !is.na(alpha))
controls <- pl_yr |> filter(within_halfmi == 0, !is.na(support))
p_control   <- mean(controls$support,  na.rm = TRUE)
mean_alpha  <- mean(treated$alpha,     na.rm = TRUE)
med_alpha   <- median(treated$alpha,   na.rm = TRUE)
n_treated   <- nrow(treated)
# Compositional effects under extreme assumptions
max_comp    <- mean_alpha * (1 - p_control)  # p_new = 1
min_comp    <- mean_alpha * (0 - p_control)  # p_new = 0 (negative = deflates)
cat(sprintf(
"  %d: n_treated=%d, mean_α=%.4f (med=%.4f), p_control=%.4f | max_comp=+%.4f, min_comp=%.4f\n",
yr, n_treated, mean_alpha, med_alpha, p_control, max_comp, min_comp
))
tibble(
year        = yr,
n_treated   = n_treated,
mean_alpha  = mean_alpha,
med_alpha   = med_alpha,
p_control   = p_control,
max_comp    = max_comp,    # max ATT inflation from new residents
min_comp    = min_comp     # max ATT deflation from new residents (negative)
)
})
years_stats
year_stats
year_stats
