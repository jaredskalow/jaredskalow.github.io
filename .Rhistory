"TOTREG", "TOTVOTE", "DEMREG", "REPREG",
"PRSDEM01", "PRSREP01",
"measureR_yes", "measureR_no", "measureR_cast", "measureR_reg",
"measureJ_yes", "measureJ_no", "measureJ_cast", "measureJ_reg",
"measureM_yes", "measureM_no", "measureM_cast", "measureM_reg")
# Build regex pattern for pivot: capture everything before the last _XX
# where XX is 08, 12, or 16
panel_long_cols <- names(panel_wide) |>
str_subset("_(04|08|12|16|20)$")
# ACS columns are time-invariant; carry them through the pivot unchanged
acs_cols <- names(panel_wide) |> str_subset("^(pct_|median_)")
panel_long <- panel_wide |>
st_drop_geometry() |>
select(SRPREC, all_of(panel_long_cols), any_of(acs_cols)) |>
pivot_longer(
cols = -c(SRPREC, any_of(acs_cols)),
names_to = c(".value", "year"),
names_pattern = "^(.+)_(\\d{2})$"
) |>
mutate(year = as.integer(paste0("20", year)))
# Unify ballot measure columns: create generic yes/no/cast/reg
panel_long <- panel_long |>
mutate(
measure_yes = coalesce(measureR_yes, measureJ_yes, measureM_yes),
measure_no  = coalesce(measureR_no,  measureJ_no,  measureM_no),
measure_cast = coalesce(measureR_cast, measureJ_cast, measureM_cast),
measure_reg = coalesce(measureR_reg, measureJ_reg, measureM_reg)
)
cat(sprintf("  Long panel: %d rows (%d precincts x %d years)\n",
nrow(panel_long), n_distinct(panel_long$SRPREC),
n_distinct(panel_long$year)))
head(panel_long)
# Wide format (CSV, no geometry)
panel_wide |>
st_drop_geometry() |>
write_csv(file.path(out_dir, "panel_wide.csv"))
# --- Treatment group classification ---
panel_desc <- panel_wide |>
st_drop_geometry() |>
mutate(
treatment_group = case_when(
within_halfmi_04 == 1                              ~ "Always treated\n(by 2004)",
within_halfmi_04 == 0 & within_halfmi_08 == 1      ~ "Newly treated\n2005-2008",
within_halfmi_08 == 0 & within_halfmi_12 == 1      ~ "Newly treated\n2009-2012",
within_halfmi_12 == 0 & within_halfmi_16 == 1      ~ "Newly treated\n2013-2016",
within_halfmi_16 == 0                              ~ "Never treated"
),
treatment_group = factor(treatment_group,
levels = c("Always treated\n(by 2004)",
"Newly treated\n2005-2008",
"Newly treated\n2009-2012",
"Newly treated\n2013-2016",
"Never treated"))
)
group_counts <- table(panel_desc$treatment_group)
cat("  Treatment groups:\n")
print(group_counts)
# Shared ggplot theme
theme_desc <- function() {
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold", size = 13),
plot.subtitle = element_text(size = 10, color = "gray40"),
strip.text = element_text(face = "bold", size = 11),
legend.position = "bottom",
panel.grid.minor = element_blank()
)
}
